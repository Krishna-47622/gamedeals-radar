VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_CHEAPSHARK_BASE=https://www.cheapshark.com/api/1.0

# --- Dev auth bypass (localhost only, never ships to prod) ---
# Set to true + provide a real Supabase user UUID to skip auth on localhost.
# Vite strips import.meta.env.DEV to false in prod builds — structural safety net.
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# --- RAWG API (free tier) for cover art fallback ---
# Get key at https://rawg.io/apidocs
VITE_RAWG_API_KEY=your_rawg_api_key
